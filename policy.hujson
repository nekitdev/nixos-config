{
    "grants": [
        // `main` has access to everything
        {
            "src": ["tag:main"],
            "dst": ["*"],
            "ip": ["*"],
        },
        // `phone` has access to `pi`
        {
            "src": ["tag:phone"],
            "dst": ["tag:pi"],
            "ip": ["*"],
        },
    ],
    "ssh": [
        // `main` can `ssh` into `pi`
        {
            "action": "accept",
            "src": ["tag:main"],
            "dst": ["tag:pi"],
            "users": ["autogroup:nonroot", "root"],
        },
        // `phone` can `ssh` into `pi`
        {
            "action": "accept",
            "src": ["tag:phone"],
            "dst": ["tag:pi"],
            "users": ["autogroup:nonroot", "root"],
        },
    ],
    "tagOwners": {
        "tag:pi": ["nekitdev@github"],
        "tag:main": ["nekitdev@github"],
        "tag:phone": ["nekitdev@github"],
    },
}
